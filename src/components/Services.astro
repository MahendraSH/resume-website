---
import { FREELANCE_SERVICES, APP_CONFIG } from '../config';
---

<div class="space-y-12 w-full">
  <!-- Services Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {FREELANCE_SERVICES.map((service) => (
      <div class="group relative flex flex-col justify-between p-6 rounded-3xl border border-zinc-900/60 bg-zinc-900/5 hover:border-zinc-800 transition-all duration-300 hover:shadow-xl hover:shadow-black/20">
        <div class="space-y-4">
          <!-- Icon & Header -->
          <div class="flex items-center gap-3">
            <span class="text-2xl">{service.icon}</span>
            <h3 class="text-lg font-bold text-zinc-100 group-hover:text-white transition-colors">
              {service.title}
            </h3>
          </div>

          <!-- Description -->
          <p class="text-xs text-zinc-450 leading-relaxed font-sans">
            {service.description}
          </p>

          <!-- Deliverables -->
          <div class="space-y-2">
            <h4 class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 font-bold">Deliverables</h4>
            <ul class="space-y-1.5 font-sans">
              {service.deliverables.map((item) => (
                <li class="flex items-start gap-2 text-xs text-zinc-300 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-500/80 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Bottom Meta / Tech Stack -->
        <div class="mt-6 pt-4 border-t border-zinc-900/60 space-y-3">
          <div class="flex flex-wrap gap-1.5">
            {service.techStack.map((tech) => (
              <span class="text-[10px] font-mono bg-zinc-900 border border-zinc-850 px-2 py-0.5 rounded text-zinc-450">
                {tech}
              </span>
            ))}
          </div>
          
          <div class="flex items-center justify-between text-[10px] font-mono">
            <span class="text-zinc-550">Ideal for:</span>
            <span class="text-zinc-350 font-semibold">{service.idealFor}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Action Card -->
  <div class="premium-card p-6 md:p-8 rounded-3xl border border-zinc-850/60 bg-zinc-900/5 text-center max-w-2xl mx-auto space-y-4">
    <h3 class="text-xl font-bold text-zinc-200">Have a custom project in mind?</h3>
    <p class="text-xs text-zinc-450 max-w-lg mx-auto font-sans leading-relaxed">
      Whether you need full-time contract support, a specific feature built, or architecture advice, we can align on custom scopes, milestones, and secure direct payments via Contra or Upwork.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <a 
        href={APP_CONFIG.socials.contra} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-blue-500 to-cyan-500 text-white text-xs font-bold font-mono transition shadow-lg shadow-blue-500/10 hover:shadow-blue-500/25 hover:scale-[1.02] active:scale-[0.98] duration-300 cursor-pointer"
      >
        <span>Hire on Contra</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
      <a 
        href={APP_CONFIG.socials.upwork} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-xs font-bold font-mono transition shadow-lg shadow-emerald-500/10 hover:shadow-emerald-500/25 hover:scale-[1.02] active:scale-[0.98] duration-300 cursor-pointer"
      >
        <span>Hire on Upwork</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</div>
