---
import { SKILL_CATEGORIES } from '../config';

const SKILL_ICONS: Record<string, string> = {
  java: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M6 11a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5H6v6Z"/><path d="M15 7h1a1.5 1.5 0 0 1 1.5 1.5v0A1.5 1.5 0 0 1 16 10h-1"/><path d="M5 15h11a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3Z"/><path d="M8 2c0 .8-.5 1.5-.5 1.5M11 2c0 .8-.5 1.5-.5 1.5"/></svg>`,
  js: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M15 9h-2a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h2"/><path d="M15 15v-6"/></svg>`,
  ts: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M10 9H8v6"/><path d="M9 9h3"/><path d="M16 15v-6h2"/><path d="M15 9h2"/></svg>`,
  db: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>`,
  api: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M16 18h6M2 6h6M12 2v20M12 12H2M22 12H12"/></svg>`,
  web: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
  spring: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M12 2C6.5 2 2 6.5 2 12c0 3 1.5 5.5 4 7l2-5c0-1.5.5-3 1.5-4.5S11.5 6.5 13 6c1 .5 2 1.5 2 3s-1 3-3 4.5-3.5 2.5-4 4.5l2 4c2.5-.5 4.5-2 6-4 2.5-3.5 2-8-2-12.5C15 2.5 13.5 2 12 2z"/></svg>`,
  workflow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M10 6.5h4M10 17.5h4M6.5 10v4M17.5 10v4"/></svg>`,
  aws: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M17.5 19A4.5 4.5 0 0 0 17 10h-1.25a7 7 0 1 0-11.75 3.5M17.5 19H9a4 4 0 0 1 0-8h1.25"/></svg>`,
  react: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(90 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(150 12 12)"/><circle cx="12" cy="12" r="1"/></svg>`,
  next: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><circle cx="12" cy="12" r="10"/><path d="M12 7v10M8 12h8"/></svg>`,
  tailwind: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"/></svg>`,
  ui: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>`,
  docker: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="5" y="3" width="14" height="14" rx="2"/><path d="M5 9h14M5 14h14M9 3v14M14 3v14"/></svg>`,
  test: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  git: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 15V9a4 4 0 0 0-4-4H9M6 9v6"/></svg>`,
  agile: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>`
};

function getSkillIcon(skill: string): string {
  const name = skill.toLowerCase();
  if (name.includes('java 21')) return 'java';
  if (name.includes('javascript')) return 'js';
  if (name.includes('typescript')) return 'ts';
  if (name.includes('sql') || name.includes('postgres') || name.includes('mysql') || name.includes('mongo') || name.includes('db')) return 'db';
  if (name.includes('openapi') || name.includes('restful') || name.includes('api')) return 'api';
  if (name.includes('html') || name.includes('css')) return 'web';
  if (name.includes('spring')) return 'spring';
  if (name.includes('microservices') || name.includes('camunda')) return 'workflow';
  if (name.includes('aws')) return 'aws';
  if (name.includes('react') || name.includes('redux') || name.includes('query')) return 'react';
  if (name.includes('next.js')) return 'next';
  if (name.includes('tailwind')) return 'tailwind';
  if (name.includes('shadcn') || name.includes('tanstack') || name.includes('prisma')) return 'ui';
  if (name.includes('docker')) return 'docker';
  if (name.includes('ci/cd') || name.includes('test') || name.includes('junit') || name.includes('mockito') || name.includes('rca')) return 'test';
  if (name.includes('git')) return 'git';
  if (name.includes('agile') || name.includes('scrum')) return 'agile';
  return 'default';
}

function getHeroSkillStyles(skill: string): { border: string; text: string; bg: string; dot: string } | null {
  const name = skill.toLowerCase();
  if (name === 'java 21') return { border: 'border-orange-500/30', text: 'text-orange-400 hover:text-orange-300', bg: 'bg-orange-500/5', dot: 'bg-orange-500' };
  if (name === 'spring boot') return { border: 'border-emerald-500/30', text: 'text-emerald-400 hover:text-emerald-300', bg: 'bg-emerald-500/5', dot: 'bg-emerald-500' };
  if (name === 'react.js') return { border: 'border-cyan-500/30', text: 'text-cyan-400 hover:text-cyan-300', bg: 'bg-cyan-500/5', dot: 'bg-cyan-500' };
  if (name === 'apache kafka') return { border: 'border-indigo-500/30', text: 'text-indigo-400 hover:text-indigo-300', bg: 'bg-indigo-500/5', dot: 'bg-indigo-500' };
  if (name.includes('aws ')) return { border: 'border-amber-500/30', text: 'text-amber-400 hover:text-amber-300', bg: 'bg-amber-500/5', dot: 'bg-amber-500' };
  if (name === 'postgresql') return { border: 'border-blue-500/30', text: 'text-blue-400 hover:text-blue-350', bg: 'bg-blue-500/5', dot: 'bg-blue-500' };
  return null;
}

// Extract and dynamically group skill lists for a highly structured Bento layout
const languages = SKILL_CATEGORIES.find(c => c.category === "Languages & Specs")?.skills || [];
const backend = SKILL_CATEGORIES.find(c => c.category === "Backend")?.skills || [];
const messaging = SKILL_CATEGORIES.find(c => c.category === "Messaging & Cloud")?.skills || [];
const frontend = SKILL_CATEGORIES.find(c => c.category === "Frontend")?.skills || [];
const databases = SKILL_CATEGORIES.find(c => c.category === "Databases & ORM")?.skills || [];
const devops = SKILL_CATEGORIES.find(c => c.category === "DevOps, QA & Tools")?.skills || [];
const security = SKILL_CATEGORIES.find(c => c.category === "Security")?.skills || [];

// Group 1: Core Backend & Specifications
const groupBackend = [...languages.filter(s => s.toLowerCase().includes('java') || s.toLowerCase() === 'sql'), ...backend];

// Group 2: Cloud, Messaging & Databases
const groupCloudData = [...messaging, ...databases];

// Group 3: Frontend & Design Systems
const groupFrontend = [...frontend, ...languages.filter(s => !s.toLowerCase().includes('java') && s.toLowerCase() !== 'sql' && !s.toLowerCase().includes('api'))];

// Group 4: DevOps, Security & QA
const groupDevOpsSecurity = [...devops, ...security, ...languages.filter(s => s.toLowerCase().includes('api'))];

const BENTO_CARDS = [
  {
    title: "Backend Core & Specifications",
    desc: "Java microservices, workflow orchestration, and runtime engines.",
    skills: groupBackend,
    span: "md:col-span-3",
    color: "text-emerald-400",
    borderGlow: "group-hover:border-emerald-500/20 group-hover:shadow-[0_0_20px_rgba(52,211,153,0.02)]",
    tagGlow: "hover:text-emerald-300 hover:border-emerald-500/30 hover:shadow-[0_0_12px_rgba(16,185,129,0.12)]"
  },
  {
    title: "Cloud, Messaging & Storage",
    desc: "Event streaming, cloud compute/storage, and database scaling.",
    skills: groupCloudData,
    span: "md:col-span-3",
    color: "text-blue-400",
    borderGlow: "group-hover:border-blue-500/20 group-hover:shadow-[0_0_20px_rgba(59,130,246,0.02)]",
    tagGlow: "hover:text-blue-300 hover:border-blue-500/30 hover:shadow-[0_0_12px_rgba(59,130,246,0.12)]"
  },
  {
    title: "Frontend & Interfaces",
    desc: "Responsive SaaS dashboards, single page apps, and css structures.",
    skills: groupFrontend,
    span: "md:col-span-2",
    color: "text-cyan-400",
    borderGlow: "group-hover:border-cyan-500/20 group-hover:shadow-[0_0_20px_rgba(34,211,238,0.02)]",
    tagGlow: "hover:text-cyan-300 hover:border-cyan-500/30 hover:shadow-[0_0_12px_rgba(6,182,212,0.12)]"
  },
  {
    title: "DevOps, Security & QA Automation",
    desc: "Container pipelines, test suites, cryptography, and agile methodologies.",
    skills: groupDevOpsSecurity,
    span: "md:col-span-4",
    color: "text-purple-400",
    borderGlow: "group-hover:border-purple-500/20 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.02)]",
    tagGlow: "hover:text-purple-300 hover:border-purple-500/30 hover:shadow-[0_0_12px_rgba(168,85,247,0.12)]"
  }
];
---

<section id="skills" class="w-full">
  <div class="premium-card p-4 sm:p-6 md:p-10 rounded-3xl space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">Tech Skills</h2>
      </div>

      <!-- Live Search Box -->
      <div class="flex items-center gap-2 max-w-xs w-full sm:w-64 bg-zinc-950/60 border border-zinc-850/60 rounded-xl px-3 py-1.5 focus-within:border-zinc-700/80 transition-all duration-300 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="skills-search" 
          placeholder="Filter skills..." 
          class="w-full bg-transparent text-xs text-zinc-300 outline-none placeholder:text-zinc-500"
        />
      </div>
    </div>

    <!-- Separator Line -->
    <div class="h-[1px] w-full bg-zinc-850/60"></div>

    <!-- Skills Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
      {BENTO_CARDS.map((card) => (
        <div 
          class={`skills-category-card p-5 rounded-2xl border border-zinc-850/60 bg-zinc-900/10 hover:bg-zinc-900/35 transition-all duration-350 flex flex-col justify-start group relative overflow-hidden ${card.span} ${card.borderGlow}`}
        >
          <!-- Top corner glow flash on hover -->
          <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-white/5 to-transparent rounded-bl-full pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <h3 class={`font-bold text-[11px] uppercase font-mono tracking-widest transition-colors ${card.color}`}>
            {card.title}
          </h3>
          <p class="text-[10px] text-zinc-500 leading-normal mb-4.5 mt-1 font-sans">
            {card.desc}
          </p>
          
          <div class="flex flex-wrap gap-2 z-10">
            {card.skills.map((skill) => {
              const iconType = getSkillIcon(skill);
              const heroStyle = getHeroSkillStyles(skill);
              
              const tagClasses = heroStyle 
                ? `${heroStyle.border} ${heroStyle.text} ${heroStyle.bg}`
                : `border-zinc-850/60 text-zinc-400 hover:text-zinc-100 hover:border-zinc-700 hover:bg-zinc-900/85 ${card.tagGlow}`;
                
              return (
                <span 
                  class={`skill-tag inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-zinc-950/60 border hover:scale-[1.015] active:scale-[0.985] transition-all duration-300 cursor-default select-none shadow-sm group/tag ${tagClasses}`}
                >
                  {heroStyle && (
                    <span class={`w-1.5 h-1.5 rounded-full ${heroStyle.dot} shrink-0 animate-pulse`}></span>
                  )}
                  {iconType !== 'default' && (
                    <span class="shrink-0 text-zinc-550 group-hover/tag:text-[currentColor] transition-colors">
                      <Fragment set:html={SKILL_ICONS[iconType]} />
                    </span>
                  )}
                  <span>{skill}</span>
                </span>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupSkillsSearch() {
    const searchInput = document.getElementById('skills-search') as HTMLInputElement | null;
    const categories = document.querySelectorAll('.skills-category-card');

    if (!searchInput) return;

    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase().trim();
      
      categories.forEach(cat => {
        const tags = cat.querySelectorAll('.skill-tag');
        let visibleTagsCount = 0;
        
        tags.forEach(tag => {
          const text = tag.textContent?.toLowerCase() || '';
          if (text.includes(val)) {
            tag.classList.remove('hidden', 'flex');
            tag.classList.add('inline-flex');
            visibleTagsCount++;
          } else {
            tag.classList.remove('inline-flex', 'flex');
            tag.classList.add('hidden');
          }
        });
        
        if (visibleTagsCount > 0 || val === '') {
          cat.classList.remove('hidden');
        } else {
          cat.classList.add('hidden');
        }
      });
    });
  }

  // Initial load
  setupSkillsSearch();
  
  // Re-run search setup on Astro page navigation swap
  document.addEventListener('astro:after-swap', setupSkillsSearch);
</script>
