---
import { APP_CONFIG } from '../config';
---

<section id="about" class="relative w-full min-h-[92vh] py-12 md:py-24 flex items-center justify-center px-0 md:px-0 overflow-hidden bg-transparent shrink-0">
  <!-- Fine Layout Structural Lines for Blueprint Aesthetic -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent -z-15 opacity-60"></div>
  <div class="absolute inset-x-0 bottom-0 h-[1px] bg-gradient-to-r from-transparent via-zinc-800 to-transparent -z-15 opacity-60"></div>
  <div class="absolute inset-y-0 left-1/4 w-[1px] bg-gradient-to-b from-transparent via-zinc-900 to-transparent -z-15 hidden lg:block opacity-45"></div>
  <div class="absolute inset-y-0 right-1/4 w-[1px] bg-gradient-to-b from-transparent via-zinc-900 to-transparent -z-15 hidden lg:block opacity-45"></div>

  <!-- Corner System Accents -->
  <div class="absolute top-8 left-8 text-zinc-700 font-mono text-[9px] tracking-widest pointer-events-none select-none hidden lg:block -z-10">
    SYS.INIT // 0x7E1B
  </div>
  <div class="absolute bottom-8 right-8 text-zinc-700 font-mono text-[9px] tracking-widest pointer-events-none select-none hidden lg:block -z-10">
    LATENCY // 0.05ms
  </div>

  <!-- Floating Tech Icons scattered across the entire Hero section -->
  <!-- Java (Top Left Area) -->
  <div class="absolute top-[12%] left-[8%] z-10 p-3 rounded-2xl border border-orange-500/10 bg-zinc-950/40 text-orange-400/50 shadow-[0_0_20px_rgba(249,115,22,0.03)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-orange-400 hover:border-orange-500/30 hover:shadow-[0_0_25px_rgba(249,115,22,0.1)] hover:opacity-100 opacity-40 animate-float-icon-1 hidden lg:flex select-none pointer-events-auto cursor-pointer" title="Java">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
      <path d="M6 11a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V5H6v6Z"/>
      <path d="M15 7h1a1.5 1.5 0 0 1 1.5 1.5v0A1.5 1.5 0 0 1 16 10h-1"/>
      <path d="M5 15h11a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3Z"/>
      <path d="M8 2c0 .8-.5 1.5-.5 1.5M11 2c0 .8-.5 1.5-.5 1.5"/>
    </svg>
  </div>

  <!-- Spring Leaf (Top Right Area) -->
  <div class="absolute top-[10%] right-[10%] z-10 p-3 rounded-2xl border border-emerald-500/10 bg-zinc-950/40 text-emerald-400/50 shadow-[0_0_20px_rgba(16,185,129,0.03)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-emerald-400 hover:border-emerald-500/30 hover:shadow-[0_0_25px_rgba(16,185,129,0.1)] hover:opacity-100 opacity-40 animate-float-icon-2 hidden lg:flex select-none pointer-events-auto cursor-pointer" title="Spring Boot">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
      <path d="M12 2C6.5 2 2 6.5 2 12c0 3 1.5 5.5 4 7l2-5c0-1.5.5-3 1.5-4.5S11.5 6.5 13 6c1 .5 2 1.5 2 3s-1 3-3 4.5-3.5 2.5-4 4.5l2 4c2.5-.5 4.5-2 6-4 2.5-3.5 2-8-2-12.5C15 2.5 13.5 2 12 2z"/>
    </svg>
  </div>

  <!-- React (Bottom Right Area) -->
  <div class="absolute bottom-[15%] right-[8%] z-10 p-3 rounded-2xl border border-cyan-500/10 bg-zinc-950/40 text-cyan-400/50 shadow-[0_0_20px_rgba(6,182,212,0.03)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-cyan-400 hover:border-cyan-500/30 hover:shadow-[0_0_25px_rgba(6,182,212,0.1)] hover:opacity-100 opacity-40 animate-float-icon-3 hidden lg:flex select-none pointer-events-auto cursor-pointer" title="React">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
      <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(30 12 12)"/>
      <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(90 12 12)"/>
      <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(150 12 12)"/>
      <circle cx="12" cy="12" r="1"/>
    </svg>
  </div>

  <!-- AWS Cloud (Bottom Left Area) -->
  <div class="absolute bottom-[12%] left-[10%] z-10 p-3 rounded-2xl border border-amber-500/10 bg-zinc-950/40 text-amber-400/50 shadow-[0_0_20px_rgba(245,158,11,0.03)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-amber-400 hover:border-amber-500/30 hover:shadow-[0_0_25px_rgba(245,158,11,0.1)] hover:opacity-100 opacity-40 animate-float-icon-4 hidden lg:flex select-none pointer-events-auto cursor-pointer" title="AWS">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
      <path d="M17.5 19A4.5 4.5 0 0 0 17 10h-1.25a7 7 0 1 0-11.75 3.5M17.5 19H9a4 4 0 0 1 0-8h1.25"/>
    </svg>
  </div>

  <!-- Keyboard Command Key (Center Left Area) -->
  <div class="absolute top-[48%] left-[4%] z-10 p-2.5 rounded-xl border border-indigo-500/10 bg-zinc-950/40 text-indigo-400/40 shadow-[0_0_15px_rgba(99,102,241,0.02)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-indigo-400 hover:border-indigo-500/30 hover:opacity-100 opacity-30 animate-float-icon-5 hidden xl:flex select-none pointer-events-auto cursor-pointer" title="Command Shortcut">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
      <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"/>
      <path d="M9 3a3 3 0 0 0-3 3v12a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z"/>
      <path d="M3 18a3 3 0 0 0 3-3h12a3 3 0 0 0 0-6H6a3 3 0 0 0-3 3z"/>
    </svg>
  </div>

  <!-- Code tag (Center Right Area) -->
  <div class="absolute top-[45%] right-[5%] z-10 p-2.5 rounded-xl border border-purple-500/10 bg-zinc-950/40 text-purple-400/40 shadow-[0_0_15px_rgba(168,85,247,0.02)] backdrop-blur-sm transition-all duration-500 hover:scale-110 hover:text-purple-400 hover:border-purple-500/30 hover:opacity-100 opacity-30 animate-float-icon-6 hidden xl:flex select-none pointer-events-auto cursor-pointer" title="Developer Tools">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
      <polyline points="16 18 22 12 16 6"/>
      <polyline points="8 6 2 12 8 18"/>
    </svg>
  </div>

  <div class="max-w-7xl 2xl:max-w-[90rem] w-full mx-auto z-10 relative">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
      
      <!-- Left Column: Content Details & Highlights -->
      <div class="flex-1 space-y-6 text-center lg:text-left">
        
        <!-- Centered Profile Image (Mobile Only) -->
        <div class="flex lg:hidden justify-center mb-4">
          <div class="relative w-24 h-24 rounded-full p-[1.5px] bg-gradient-to-tr from-zinc-800 via-zinc-700 to-zinc-800 shadow-xl">
            <div class="w-full h-full rounded-full overflow-hidden bg-zinc-950 p-1 flex items-center justify-center relative">
              <img
                src="https://github.com/MahendraSH.png"
                alt="Mahendra S H"
                class="w-full h-full object-cover rounded-full filter grayscale hover:grayscale-0 transition-all duration-500"
                loading="eager"
              />
              <!-- Online status dot -->
              <span class="absolute bottom-1 right-1 flex h-3 w-3 z-20">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500 border border-zinc-950"></span>
              </span>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <!-- Badges -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
            <!-- Open to Opportunities badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[9px] sm:text-[10px] font-mono tracking-wider text-emerald-400 uppercase w-fit shadow-[0_0_15px_rgba(16,185,129,0.05)]">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
              </span>
              <span>Open to Opportunities</span>
            </div>

            <!-- Remote / Hybrid Jobs badge -->
            <div class="relative group inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-[9px] sm:text-[10px] font-mono tracking-wider text-blue-400 uppercase w-fit shadow-[0_0_15px_rgba(59,130,246,0.05)] cursor-help">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <span>Remote / Hybrid</span>
            </div>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-none bg-gradient-to-b from-white via-zinc-100 to-zinc-400 bg-clip-text text-transparent">
            Mahendra S H
          </h1>
          
          <div class="h-8 md:h-10 text-base sm:text-lg md:text-xl font-mono text-zinc-300 flex justify-center lg:justify-start items-center">
            <span>I architect&nbsp;</span>
            <span id="typewriter" class="bg-gradient-to-r from-blue-400 via-cyan-400 to-emerald-400 bg-clip-text text-transparent font-extrabold border-r-2 pr-1 min-h-[1.5em] flex items-center typewriter-cursor"></span>
          </div>
        </div>

        <p class="text-zinc-400 text-xs sm:text-sm md:text-base leading-relaxed max-w-xl mx-auto lg:mx-0 font-sans">
          Java Cloud Engineer specializing in high-throughput backend microservices, event-driven queues, and responsive SaaS dashboards with <strong class="text-zinc-200">Java 21, Spring Boot, React, and AWS</strong>.
        </p>

        <!-- 3 Glass Stat Cards Grid (Optimized for Mobile Row) -->
        <div class="grid grid-cols-3 gap-2.5 max-w-xl mx-auto lg:mx-0 pt-2">
          <!-- Card 1: Experience -->
          <div class="glass-panel p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-zinc-900 bg-zinc-900/10 flex flex-col items-center lg:items-start text-center lg:text-left group/card hover:border-zinc-800/80 transition-all duration-300">
            <div class="text-sm sm:text-lg md:text-xl font-black text-blue-400 group-hover/card:scale-105 transition-transform duration-300 font-mono">3+ Years</div>
            <div class="text-[8px] sm:text-[10px] text-zinc-350 font-bold uppercase mt-1 font-mono tracking-wider">Enterprise Dev</div>
            <div class="hidden sm:block text-[9px] text-zinc-550 mt-0.5">Specialist Programmer (Infosys)</div>
          </div>

          <!-- Card 2: Scale -->
          <div class="glass-panel p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-zinc-900 bg-zinc-900/10 flex flex-col items-center lg:items-start text-center lg:text-left group/card hover:border-zinc-800/80 transition-all duration-300">
            <div class="text-sm sm:text-lg md:text-xl font-black text-emerald-400 group-hover/card:scale-105 transition-transform duration-300 font-mono">50k+ Daily</div>
            <div class="text-[8px] sm:text-[10px] text-zinc-350 font-bold uppercase mt-1 font-mono tracking-wider">Bookings</div>
            <div class="hidden sm:block text-[9px] text-zinc-550 mt-0.5">Automated Spring Batch checks</div>
          </div>

          <!-- Card 3: Stack -->
          <div class="glass-panel p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-zinc-900 bg-zinc-900/10 flex flex-col items-center lg:items-start text-center lg:text-left group/card hover:border-zinc-800/80 transition-all duration-300">
            <div class="text-sm sm:text-lg md:text-xl font-black text-purple-400 group-hover/card:scale-105 transition-transform duration-300 font-mono">Java 21</div>
            <div class="text-[8px] sm:text-[10px] text-zinc-350 font-bold uppercase mt-1 font-mono tracking-wider">Spring & AWS</div>
            <div class="hidden sm:block text-[9px] text-zinc-550 mt-0.5">REST APIs & Kafka messaging</div>
          </div>
        </div>

        <!-- Contact/Email Info & Location -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-x-5 gap-y-2.5 pt-2">
          <!-- Email -->
          <div class="flex items-center gap-2 text-xs font-mono text-zinc-450 hover:text-zinc-300 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-400/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${APP_CONFIG.author.email}`} class="hover:underline">{APP_CONFIG.author.email}</a>
          </div>
          <!-- Location -->
          <div class="flex items-center gap-2 text-xs font-mono text-zinc-450">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-400/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{APP_CONFIG.author.location}</span>
          </div>
        </div>

        <!-- Social Icons & CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-1">
          <!-- Social Link Group -->
          <div class="flex items-center gap-2 shrink-0">
            <a
              href={APP_CONFIG.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl border border-zinc-850 bg-zinc-900/40 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-100 flex items-center justify-center transition shadow-sm hover:scale-105 active:scale-95 duration-200"
              title="GitHub"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.197 22 16.44 22 12.017 22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
            <a
              href={APP_CONFIG.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl border border-zinc-850 bg-zinc-900/40 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-100 flex items-center justify-center transition shadow-sm hover:scale-105 active:scale-95 duration-200"
              title="LinkedIn"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
            </a>
            {APP_CONFIG.socials.twitter && (
              <a
                href={APP_CONFIG.socials.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-xl border border-zinc-850 bg-zinc-900/40 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-100 flex items-center justify-center transition shadow-sm hover:scale-105 active:scale-95 duration-200"
                title="X (formerly Twitter)"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}
            <a
              href={APP_CONFIG.socials.upwork}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl border border-zinc-850 bg-zinc-900/40 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-100 flex items-center justify-center transition shadow-sm hover:scale-105 active:scale-95 duration-200"
              title="Upwork"
            >
              <svg role="img" viewBox="0 0 24 24" fill="currentColor" class="w-4.5 h-4.5" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.548-1.405-.002-2.543-1.143-2.543-2.548V3.56H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-.354c.511 1.365 1.251 2.946 2.222 4.486l-1.637 7.692h2.825l1.197-5.636c.99.637 2.115 1.009 3.39 1.009 3.037 0 5.51-2.435 5.51-5.51-.001-3.075-2.473-5.51-5.51-5.51z" />
              </svg>
            </a>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <a
              href="/mahendra_sh_fullstack_resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 sm:flex-initial relative group px-4 py-2.5 rounded-xl bg-gradient-to-r from-zinc-100 to-white text-zinc-950 text-xs font-bold font-mono transition shadow-[0_4px_20px_rgba(255,255,255,0.06)] hover:shadow-[0_4px_30px_rgba(59,130,246,0.2)] hover:scale-[1.02] active:scale-[0.98] duration-300 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Resume PDF</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-950 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="/contact"
              class="flex-1 sm:flex-initial relative group px-4 py-2.5 rounded-xl bg-zinc-950 hover:bg-zinc-900 text-zinc-200 hover:text-white text-xs font-bold font-mono transition border border-zinc-800 hover:border-zinc-700 hover:scale-[1.02] active:scale-[0.98] duration-300 cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Connect</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-zinc-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Code Terminal & Framed Profile Image -->
      <div class="w-full lg:w-5/12 max-w-lg lg:max-w-none shrink-0 flex flex-col gap-6 relative mt-4 lg:mt-0 pt-2 lg:pt-6">
        <div class="relative w-full">
          <!-- Glowing backplate behind the terminal window -->
          <div class="absolute -inset-2.5 rounded-2xl bg-gradient-to-r from-blue-500/10 via-purple-500/10 to-pink-500/10 opacity-70 blur-2xl pointer-events-none -z-10 animate-pulse-slow"></div>
          
          <!-- Interactive Terminal Container -->
          <div class="glass-panel w-full border border-zinc-800/80 bg-zinc-950/75 rounded-2xl overflow-hidden shadow-2xl relative">
            <!-- Terminal Title Bar -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-zinc-900 bg-zinc-950/90 select-none">
              <div class="flex items-center gap-1.5">
                <span class="w-3 h-3 rounded-full bg-[#ff5f56] opacity-90"></span>
