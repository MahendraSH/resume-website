    0%, 100% { border-color: rgba(96, 165, 250, 0.85); }
    50% { border-color: transparent; }
  }

  .typewriter-cursor {
    animation: blinkCursor 0.75s step-end infinite;
  }

  /* Independent Floating Animations for Tech Icons */
  @keyframes floatIcon1 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) translateX(-2px) rotate(4deg); }
  }
  @keyframes floatIcon2 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) translateX(3px) rotate(-6deg); }
  }
  @keyframes floatIcon3 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-6px) translateX(4px) rotate(8deg); }
  }
  @keyframes floatIcon4 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-12px) translateX(-3px) rotate(-5deg); }
  }
  @keyframes floatIcon5 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) translateX(2px) rotate(6deg); }
  }
  @keyframes floatIcon6 {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-9px) translateX(-4px) rotate(-8deg); }
  }

  .animate-float-icon-1 { animation: floatIcon1 5s ease-in-out infinite; }
  .animate-float-icon-2 { animation: floatIcon2 6s ease-in-out infinite 0.3s; }
  .animate-float-icon-3 { animation: floatIcon3 5.5s ease-in-out infinite 0.6s; }
  .animate-float-icon-4 { animation: floatIcon4 6.5s ease-in-out infinite 0.9s; }
  .animate-float-icon-5 { animation: floatIcon5 5.8s ease-in-out infinite 1.2s; }
  .animate-float-icon-6 { animation: floatIcon6 6.2s ease-in-out infinite 1.5s; }
</style>

<script>
  function runTypewriter() {
    const words = [
      "high-throughput microservices.",
      "event-driven event streams.",
      "responsive SaaS dashboards.",
      "scalable cloud applications."
    ];
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    const el = document.getElementById('typewriter');
    if (!el) return;

    function type() {
      const currentWord = words[wordIndex];
      if (isDeleting) {
        el.textContent = currentWord.substring(0, charIndex - 1);
        charIndex--;
      } else {
        el.textContent = currentWord.substring(0, charIndex + 1);
        charIndex++;
      }

      let typeSpeed = isDeleting ? 30 : 60;

      if (!isDeleting && charIndex === currentWord.length) {
        typeSpeed = 2200; // Pause at end of word
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        typeSpeed = 300; // Pause before typing next word
      }

      setTimeout(type, typeSpeed);
    }

    type();
  }

  function setupTerminalTabs() {
    const tabs = document.querySelectorAll('.terminal-tab');
    const contents = document.querySelectorAll('.terminal-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        // Reset active tab button styles
        tabs.forEach(t => {
          t.classList.remove('border-b-blue-500', 'bg-zinc-900/60', 'text-zinc-100', 'font-bold');
          t.classList.add('border-b-transparent', 'text-zinc-500', 'hover:text-zinc-350');
        });

        // Add active tab button styles
        tab.classList.remove('border-b-transparent', 'text-zinc-500', 'hover:text-zinc-350');
        tab.classList.add('border-b-blue-500', 'bg-zinc-900/60', 'text-zinc-100', 'font-bold');

        // Hide all pre contents
        contents.forEach(content => {
          content.classList.add('hidden');
        });

        // Show target content
        const targetContent = document.getElementById(`content-${targetId}`);
        if (targetContent) {
          targetContent.classList.remove('hidden');
        }
      });
    });
  }

  function initHero() {
    runTypewriter();
    setupTerminalTabs();
  }

  // Initial load
  initHero();
  
  // Re-run typewriter and tabs on Astro page navigation swaps
  document.addEventListener('astro:after-swap', initHero);
</script>
