---
import { EDUCATION, CERTIFICATIONS } from '../config';
---

<section id="education" class="w-full">
  <div class="premium-card p-4 sm:p-6 md:p-10 rounded-3xl space-y-8">
    <!-- Header -->
    <div>
      <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">
        Education & Certifications
      </h2>
      <p class="text-xs md:text-sm text-zinc-400 mt-1">
        Academic foundations and industry-validated professional credentials.
      </p>
    </div>

    <!-- Separator Line -->
    <div class="h-[1px] w-full bg-zinc-850/60"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Education (5 Cols on LG) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-blue-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          <span>University Degree</span>
        </div>

        <div class="space-y-4 p-4 sm:p-5 md:p-6 rounded-2xl border border-zinc-900/60 bg-zinc-900/10 shadow-sm transition-all duration-300 hover:border-zinc-800">
          <div class="flex flex-col gap-1">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-bold text-zinc-100">
                {EDUCATION.degree}
              </h3>
              <!-- Date Badge -->
              <span class="text-[10px] font-mono text-zinc-400 bg-zinc-950/80 border border-zinc-850 px-2.5 py-1 rounded-lg shrink-0">
                {EDUCATION.duration}
              </span>
            </div>
            <p class="text-xs font-semibold text-blue-400/90 font-mono">
              {EDUCATION.school} <span class="text-zinc-500 font-normal font-sans">| {EDUCATION.location}</span>
            </p>
          </div>

          <div class="space-y-2.5 pt-2 border-t border-zinc-850/50 text-xs text-zinc-300 font-sans">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400 shrink-0">
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
              <span><strong class="text-zinc-200">Grade:</strong> {EDUCATION.grade}</span>
            </div>
            <p class="text-[12px] text-zinc-400 leading-relaxed">
              <strong class="text-zinc-300">Relevant Coursework:</strong> {EDUCATION.coursework}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Certifications (7 Cols on LG) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
            <span>Verified Certifications</span>
          </div>
          <span class="text-[10px] font-mono text-zinc-500">DataCamp Certified</span>
        </div>

        <div class="space-y-3.5">
          {CERTIFICATIONS.map((cert) => (
            <div class="p-4 sm:p-5 rounded-2xl border border-zinc-900/60 bg-zinc-900/10 shadow-sm transition-all duration-300 hover:border-emerald-500/30 hover:bg-zinc-900/20 group">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
                      {cert.name}
                    </h3>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-mono uppercase tracking-wider bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                      ✓ {cert.badge}
                    </span>
                  </div>
                  <p class="text-xs font-mono text-zinc-400">
                    <span class="text-zinc-200 font-semibold">{cert.issuer}</span>
                    {cert.credentialId && (
                      <span class="text-zinc-500 ml-1.5">• ID: <code class="text-zinc-350 bg-zinc-950 px-1 py-0.5 rounded text-[10px]">{cert.credentialId}</code></span>
                    )}
                  </p>
                </div>
                <span class="text-[10px] font-mono text-zinc-400 bg-zinc-950/80 border border-zinc-850 px-2.5 py-1 rounded-lg w-fit shrink-0">
                  {cert.issueDate}
                </span>
              </div>

              <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
                {cert.description}
              </p>

              <!-- Skills tags -->
              <div class="flex flex-wrap gap-1.5 mt-3 pt-2.5 border-t border-zinc-850/40">
                {cert.skills.map((skill) => (
                  <span class="text-[10px] font-mono text-zinc-400 bg-zinc-950/60 border border-zinc-850/60 px-2 py-0.5 rounded-md">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
