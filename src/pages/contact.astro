---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { APP_CONFIG } from '../config';

const contactDescription = "Get in touch with Mahendra S H. Feel free to reach out via email, phone, or LinkedIn to discuss engineering roles, freelance contracts, or technical projects.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": `Contact | ${APP_CONFIG.name}`,
  "description": contactDescription,
  "url": `${APP_CONFIG.domain}/contact/`,
  "mainEntity": {
    "@type": "Person",
    "name": APP_CONFIG.author.name,
    "email": APP_CONFIG.author.email,
    "telephone": APP_CONFIG.author.phone,
    "jobTitle": "Full-Stack Developer"
  }
};
---

<Layout 
  title={`Contact | ${APP_CONFIG.name}`} 
  description={contactDescription}
  schema={contactSchema}
>
  <Navbar />

  <main class="w-full max-w-5xl 2xl:max-w-[75rem] mx-auto px-4 md:px-8 pt-24 pb-12 md:pt-32 md:pb-20 space-y-10">
    <!-- Page Header -->
    <div class="text-center space-y-4 max-w-xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-[9px] sm:text-[10px] font-mono tracking-wider text-blue-400 uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span>Let's Connect</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black bg-gradient-to-b from-white via-zinc-100 to-zinc-400 bg-clip-text text-transparent tracking-tight leading-none">
        Get in Touch
      </h1>
      <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
        I am open to discussing microservice backend designs, React dashboard work, full-stack contracts, or enterprise software engineering roles.
      </p>
    </div>

    <!-- Separator Line -->
    <div class="h-[1px] w-full bg-zinc-850/60"></div>

    <!-- Contact Bento Grid -->
    <div class="grid gap-4 sm:gap-6 grid-cols-1 md:grid-cols-6 max-w-4xl mx-auto">
      
      <!-- Email Card (Span 3 on Desktop) -->
      <div 
        class="group premium-card p-4 sm:p-5 rounded-2xl flex items-center justify-between gap-4 md:col-span-3 transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_0_20px_rgba(59,130,246,0.04)]"
      >
        <a 
          href={`mailto:${APP_CONFIG.author.email}`} 
          class="flex items-center gap-4 min-w-0 flex-1 hover:opacity-95"
        >
          <div class="p-3 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-zinc-400 group-hover:border-blue-500/30 group-hover:text-blue-400 transition-all duration-300 shadow-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </div>
          <div class="text-left space-y-0.5 min-w-0 flex-1">
            <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">Email</div>
            <div class="text-xs sm:text-sm font-semibold text-zinc-250 group-hover:text-zinc-50 transition-colors truncate">{APP_CONFIG.author.email}</div>
          </div>
        </a>
        <!-- Copy Button -->
        <button
          type="button"
          data-copy-text={APP_CONFIG.author.email}
          class="copy-btn p-1.5 rounded-lg bg-zinc-950/60 border border-zinc-850/80 hover:border-zinc-700 text-zinc-500 hover:text-zinc-200 transition-all cursor-pointer shrink-0 z-10"
          title="Copy email"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
        </button>
      </div>
 
       <!-- Phone Card (Span 3 on Desktop) -->
      <div 
        class="group premium-card p-4 sm:p-5 rounded-2xl flex items-center justify-between gap-4 md:col-span-3 transition-all duration-300 hover:border-emerald-500/30 hover:shadow-[0_0_20px_rgba(16,185,129,0.04)]"
      >
        <a 
          href={`tel:${APP_CONFIG.author.phone.replace(/-/g, '')}`} 
          class="flex items-center gap-4 min-w-0 flex-1 hover:opacity-95"
        >
          <div class="p-3 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-zinc-400 group-hover:border-emerald-500/30 group-hover:text-emerald-400 transition-all duration-300 shadow-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </div>
          <div class="text-left space-y-0.5 min-w-0 flex-1">
            <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">Phone</div>
            <div class="text-xs sm:text-sm font-semibold text-zinc-250 group-hover:text-zinc-50 transition-colors truncate">{APP_CONFIG.author.phone}</div>
          </div>
        </a>
        <!-- Copy Button -->
        <button
          type="button"
          data-copy-text={APP_CONFIG.author.phone}
          class="copy-btn p-1.5 rounded-lg bg-zinc-950/60 border border-zinc-850/80 hover:border-zinc-700 text-zinc-500 hover:text-zinc-200 transition-all cursor-pointer shrink-0 z-10"
          title="Copy phone"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
        </button>
      </div>

      <!-- LinkedIn Card (Span 2 on Desktop) -->
      <a 
        href={APP_CONFIG.socials.linkedin} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group premium-card p-4 sm:p-5 rounded-2xl flex items-center gap-4 md:col-span-2 transition-all duration-300 hover:border-cyan-500/30 hover:shadow-[0_0_20px_rgba(6,182,212,0.04)]"
      >
        <div class="p-2.5 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-zinc-400 group-hover:border-cyan-500/30 group-hover:text-cyan-400 transition-all duration-300 shadow-sm shrink-0">
          <svg class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </div>
        <div class="text-left space-y-0.5 min-w-0 flex-1">
          <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">LinkedIn</div>
          <div class="text-xs font-semibold text-zinc-250 group-hover:text-zinc-50 transition-colors truncate">mahendra-s-h</div>
        </div>
      </a>

      <!-- GitHub Card (Span 2 on Desktop) -->
      <a 
        href={APP_CONFIG.socials.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group premium-card p-4 sm:p-5 rounded-2xl flex items-center gap-4 md:col-span-2 transition-all duration-300 hover:border-purple-500/30 hover:shadow-[0_0_20px_rgba(168,85,247,0.04)]"
      >
        <div class="p-2.5 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-zinc-400 group-hover:border-purple-500/30 group-hover:text-purple-400 transition-all duration-300 shadow-sm shrink-0">
          <svg class="h-4.5 w-4.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.197 22 16.44 22 12.017 22 6.484 17.522 2 12 2z"/>
          </svg>
        </div>
        <div class="text-left space-y-0.5 min-w-0 flex-1">
          <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">GitHub</div>
          <div class="text-xs font-semibold text-zinc-250 group-hover:text-zinc-50 transition-colors truncate">MahendraSH</div>
        </div>
      </a>

      <!-- Upwork Card (Span 2 on Desktop) -->
      <a 
        href={APP_CONFIG.socials.upwork} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group premium-card p-4 sm:p-5 rounded-2xl flex items-center gap-4 md:col-span-2 transition-all duration-300 hover:border-amber-500/30 hover:shadow-[0_0_20px_rgba(245,158,11,0.04)]"
      >
        <div class="p-2.5 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-zinc-400 group-hover:border-amber-500/30 group-hover:text-amber-400 transition-all duration-300 shadow-sm shrink-0">
          <svg role="img" viewBox="0 0 24 24" fill="currentColor" class="w-4.5 h-4.5">
            <path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.548-1.405-.002-2.543-1.143-2.543-2.548V3.56H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-.354c.511 1.365 1.251 2.946 2.222 4.486l-1.637 7.692h2.825l1.197-5.636c.99.637 2.115 1.009 3.39 1.009 3.037 0 5.51-2.435 5.51-5.51-.001-3.075-2.473-5.51-5.51-5.51z" />
          </svg>
        </div>
        <div class="text-left space-y-0.5 min-w-0 flex-1">
          <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">Upwork</div>
          <div class="text-xs font-semibold text-zinc-250 group-hover:text-zinc-50 transition-colors truncate">Freelance</div>
        </div>
      </a>

      <!-- Location Card (Span 4 on Desktop) -->
      <div 
        class="premium-card p-4 sm:p-5 rounded-2xl flex flex-col justify-between gap-4 md:col-span-4 shadow-lg border border-zinc-850/60 bg-zinc-900/10 hover:border-zinc-800 transition-all"
      >
        <div class="flex items-center gap-4">
          <div class="p-3 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-blue-400 shadow-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5.5 w-5.5">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div class="text-left space-y-0.5">
            <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">Location</div>
            <div class="text-sm font-semibold text-zinc-200">{APP_CONFIG.author.location}</div>
          </div>
        </div>
        
        <!-- Live Clock widget inside the Location card -->
        <div class="border-t border-zinc-900/60 pt-3 flex items-center justify-between text-[11px] font-mono text-zinc-450 select-none">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
            </span>
            <span>Hyderabad Time (IST)</span>
          </div>
          <span id="local-clock" class="text-zinc-300 font-bold font-mono tracking-wider">--:--:-- --</span>
        </div>
      </div>

      <!-- Timezone/Preferences Card (Span 2 on Desktop) -->
      <div 
        class="premium-card p-4 sm:p-5 rounded-2xl flex flex-col justify-between gap-4 md:col-span-2 shadow-lg border border-zinc-850/60 bg-zinc-900/10 hover:border-zinc-800 transition-all"
      >
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-zinc-900/60 border border-zinc-850/80 rounded-xl text-emerald-400 shadow-sm shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4.5 w-4.5">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div class="text-left space-y-0.5">
            <div class="text-[9px] text-zinc-550 uppercase tracking-widest font-mono font-bold">Preferences</div>
            <div class="text-xs font-semibold text-zinc-250">UTC+5:30 (IST)</div>
          </div>
        </div>
        <div class="text-[10px] text-zinc-500 font-mono leading-relaxed border-t border-zinc-900/60 pt-3">
          Preferred: Hybrid / Remote roles in BGLR, HYD, or Pune.
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  function updateClock() {
    const clockEl = document.getElementById('local-clock');
    if (!clockEl) return;
    
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true
    };
    
    try {
      const formatter = new Intl.DateTimeFormat([], options);
      clockEl.textContent = formatter.format(new Date());
    } catch (e) {
      // Fallback
      clockEl.textContent = new Date().toLocaleTimeString();
    }
  }

  function setupCopyButtons() {
    const copyBtns = document.querySelectorAll('.copy-btn');
    
    copyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // Avoid triggering mailto/tel link clicks
        
        const text = btn.getAttribute('data-copy-text');
        if (!text) return;
        
        navigator.clipboard.writeText(text).then(() => {
          const originalHTML = btn.innerHTML;
          // Show green check icon
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
          
          setTimeout(() => {
            btn.innerHTML = originalHTML;
          }, 2000);
        });
      });
    });
  }

  function initContactPage() {
    updateClock();
    setupCopyButtons();
    // Start running clock timer
    const intervalId = setInterval(updateClock, 1000);
    
    // Store interval ID in document element so we can clear it on Astro swap
    (document as any)._contactClockInterval = intervalId;
  }

  // Initial load
  initContactPage();

  // Handle Astro swap liveness cleanup and setup
  document.addEventListener('astro:before-swap', () => {
    if ((document as any)._contactClockInterval) {
      clearInterval((document as any)._contactClockInterval);
    }
  });

  document.addEventListener('astro:after-swap', initContactPage);
</script>
